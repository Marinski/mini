{
  "name": "@marinski/mini",
  "version": "0.2.0",
  "description": "A minimal coding agent (bash, read, edit, write) for OpenAI-compatible models, sandboxed in Docker by default.",
  "type": "module",
  "bin": {
    "mini": "dist/mini.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marinski/mini.git"
  },
  "keywords": [
    "coding-agent",
    "llm",
    "openai",
    "cli"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "openai": "^7.23.0",
    "typescript": "^5.9.0"
  }
}
