# agent-trial:4 = agent-trial:3 plus Aider and Hermes Agent, each in its own venv (batch 5).
FROM agent-trial:3
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/aider && /opt/aider/bin/pip install --no-cache-dir aider-chat==0.86.2 \
 && ln -s /opt/aider/bin/aider /usr/local/bin/aider
RUN python3 -m venv /opt/hermes && /opt/hermes/bin/pip install --no-cache-dir hermes-agent==0.19.0 \
 && ln -s /opt/hermes/bin/hermes /usr/local/bin/hermes
USER agent
